# =====================================================================
#  SKIPPER PACKS SOCIAL AGENT — YOUR KEYS
# ---------------------------------------------------------------------
#  EASIEST: don't edit this file at all. Start the app and paste keys
#  in Control Center → Connect accounts. It saves them here.
#
#  If you do edit by hand: paste each key right after the "=" sign,
#  with no spaces and no quotes. Step-by-step help for each key is in
#  docs/SETUP_GUIDE.md.
#
#  This file is private. It is listed in .gitignore, so it never goes
#  to GitHub. Never email it or paste it into chat.
# =====================================================================


# --- Claude (writes captions and plans) -------------------------------
# Get it: https://console.anthropic.com/settings/keys → "Create Key"
# Starts with: sk-ant-
ANTHROPIC_API_KEY=paste-your-key-here


# --- Gemini (AI images and Veo reels) ---------------------------------
# Get it: https://aistudio.google.com/apikey → "Create API key"
# For reels (Veo), billing must be turned on for the Google Cloud
# project behind the key. Starts with: AIza
GEMINI_API_KEY=paste-your-key-here


# --- Shopify (reads your products) ------------------------------------
# Option A (new stores / since Jan 2026): an app made in the Shopify
#   Dev Dashboard: https://dev.shopify.com/dashboard
#   Copy the Client ID and Client secret from the Shopify app's Settings tab.
SHOPIFY_CLIENT_ID=paste-your-key-here
SHOPIFY_CLIENT_SECRET=paste-your-key-here
# Option B: only if you ALREADY have an old custom-app token that
#   starts with shpat_ . Otherwise leave this empty.
SHOPIFY_ADMIN_TOKEN=


# --- Meta (posts to Instagram + Facebook) -----------------------------
# Get it: https://business.facebook.com/settings/system-users
#   → your system user → "Generate new token" (choose "Never expire").
# Full steps in docs/SETUP_GUIDE.md, section 5.
META_ACCESS_TOKEN=paste-your-key-here


# --- Telegram (sends you drafts to approve) ---------------------------
# Get it: open Telegram, chat with @BotFather, send /newbot.
# Looks like: 1234567890:AAH...
TELEGRAM_BOT_TOKEN=paste-your-key-here
# Your personal chat number (not secret). Steps in docs/SETUP_GUIDE.md.
TELEGRAM_CHAT_ID=


# --- Control Center login (filled in automatically; leave alone) ------
SETTINGS_PASSWORD_HASH=
FLASK_SECRET_KEY=
